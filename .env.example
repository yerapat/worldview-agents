# Copy to .env and fill in only the vendors you plan to call.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=

# OpenAI-compatible local endpoint (Ollama or vLLM). Ollama's default is shown.
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_API_KEY=local

# Where run outputs and the SQLite index go. Defaults shown.
WVA_RUNS_DIR=runs
WVA_DB_PATH=db/runs.sqlite
